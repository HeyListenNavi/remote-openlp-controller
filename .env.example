# Where OpenLP is listening. Port 4316 is the default Remote API port.
OPENLP_BASE_URL=http://openlp-pc:4316

# Only needed if you enabled "Require authentication" in OpenLP Remote settings.
# OPENLP_USERNAME=remote
# OPENLP_PASSWORD=secret

# Optional PIN to protect this app. Set it before exposing through a tunnel.
# APP_PASSWORD=change-me

# How often (ms) the browser polls OpenLP for the current state.
# POLL_INTERVAL_MS=1500

# Port the app listens on (Coolify sets PORT automatically).
# PORT=3000